<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/bg_light"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:text="📢 BROADCAST PESAN"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:layout_marginBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:text="Pesan akan dikirim ke semua user client"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/etBroadcastMsg"
        android:hint="Tulis pesan broadcast..."
        android:minLines="3"
        android:gravity="top"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:layout_marginBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/btnSendBroadcast"
        android:text="📤 Kirim Broadcast"
        android:backgroundTint="@color/primary"
        android:textColor="@color/text_white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
