<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:text="Setup GitHub Token"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:text="Format file .txt:\n\nghp_xxxxxxxxxxxxxxxxxxxx\n\nAtau:\nTOKEN=ghp_xxxxxxxxxxxx\n\nToken dari txt akan MENIMPA token embed."
        android:padding="12dp"
        android:background="#EEEEEE"
        android:layout_marginBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/btnUploadTokenTxt"
        android:text="📁 Upload token.txt"
        android:layout_width="match_parent"
        android:layout_height="56dp"/>

    <Button
        android:id="@+id/btnClearToken"
        android:text="🗑️ Hapus Token Upload"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/tvTokenStatus"
        android:text="Memuat..."
        android:padding="16dp"
        android:layout_marginTop="24dp"
        android:background="#DDDDDD"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/btnBackFromToken"
        android:text="Kembali"
        android:layout_marginTop="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
